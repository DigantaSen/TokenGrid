# --- Secrets -----------------------------------------------------------------
# No .env file is ever committed. backend/.env.example (no values) shows which
# keys to set. The frontend needs no .env: without one, App.jsx defaults to the
# backend at localhost:8842.
.env
.env.*
!.env.example

# --- Python --------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Node / frontend -----------------------------------------------------------
node_modules/
frontend/dist/
*.log

# --- Evaluation data -----------------------------------------------------------
# Downloaded benchmark files: re-downloaded automatically by app/tasks.py.
backend/data/
# Synthetic (--mock) runs: regenerate with --mock; never results.
backend/results/mock/
# Embedding cache: rebuilt automatically by run_experiments.py.
backend/results/*/embeddings.npz
# Local safety copy made before error rows were cleaned out.
backend/results/*/traces_backup_*.jsonl
# Partial files from interrupted downloads/writes.
*.part
*.tmp
# KEPT on purpose: backend/results/groq/traces.jsonl (the real dataset, the
# irreplaceable part) and backend/results/groq/report*/ (the reported results).

# --- OS / editors --------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
